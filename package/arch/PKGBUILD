pkgname=btop-gpu-sort-git
pkgver=1.4.7.r113.ga9681f2
pkgrel=2
_commit=a9681f27563585e415877ae1d0c36713a35d4803
pkgdesc='Resource monitor with NVIDIA per-process GPU utilization and VRAM sorting'
arch=('x86_64')
url='https://github.com/infyrno1010101/btop'
license=('Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cmake' 'git')
provides=("btop=${pkgver}")
conflicts=('btop')
source=("btop::git+https://github.com/infyrno1010101/btop.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
	cmake \
		-S btop \
		-B build \
		-DBTOP_GPU=ON \
		-DBUILD_TESTING=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
	install -Dm644 btop/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
