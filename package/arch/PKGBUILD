pkgname=btop-gpu-sort-git
pkgver=1.4.7.r1692.g868ffa1
pkgrel=1
_commit=868ffa1abc220bd7cdaa0178e48ab36e3cff54df
pkgdesc='Resource monitor with GPU sorting and local inference, Ollama, and per-server GPU telemetry'
arch=('x86_64')
url='https://github.com/infyrno1010101/btop'
license=('Apache-2.0' 'MIT')
options=('!debug' '!lto')
depends=('gcc-libs' 'glibc')
makedepends=('cmake' 'git')
provides=("btop=1.4.7")
conflicts=('btop')
source=("btop::git+https://github.com/infyrno1010101/btop.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
	cmake \
		-S btop \
		-B build \
		-DBTOP_GPU=ON \
		-DBUILD_TESTING=OFF \
		-DBTOP_LTO=OFF \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build --parallel "${BTOP_BUILD_JOBS:-4}"
}

package() {
	DESTDIR="${pkgdir}" cmake --install build
	install -Dm644 btop/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
